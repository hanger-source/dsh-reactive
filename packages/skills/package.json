{
  "name": "@hanger-source/dsh-reactive-skills",
  "version": "0.22.0",
  "description": "面向编码 Agent 的 dsh-reactive 应用开发 Skill",
  "license": "UNLICENSED",
  "author": "hanger",
  "publishConfig": { "registry": "https://registry.npmjs.org", "tag": "next", "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/hanger-source/dsh-reactive.git", "directory": "packages/skills" },
  "type": "module",
  "engines": { "node": ">=24.18.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.mjs" },
    "./package.json": "./package.json"
  },
  "bin": { "dsh-reactive-skill": "./dist/cli.mjs" },
  "files": ["dist", "skills", "CHANGELOG.md", "release.json"],
  "scripts": {
    "build": "wireit",
    "prepack": "npm run build"
  },
  "wireit": {
    "build": {
      "command": "node ../../scripts/archive-build-output.mjs build && node scripts/build.mjs",
      "files": [
        "../../scripts/archive-build-output.mjs",
        "scripts/build.mjs",
        "src/**",
        "templates/**",
        "package.json"
      ],
      "output": [
        "dist/**",
        "skills/**"
      ],
      "clean": false
    }
  },
  "peerDependencies": {
    "@hanger-source/dsh-reactive": "0.22.0",
    "@hanger-source/dsh-reactive-dsh": "0.22.0",
    "@hanger-source/dsh-reactive-client": "0.22.0",
    "@hanger-source/dsh-reactive-remote": "0.22.0",
    "@hanger-source/dsh-reactive-native-ui": "0.22.0"
  },
  "peerDependenciesMeta": {
    "@hanger-source/dsh-reactive": { "optional": true },
    "@hanger-source/dsh-reactive-dsh": { "optional": true },
    "@hanger-source/dsh-reactive-client": { "optional": true },
    "@hanger-source/dsh-reactive-remote": { "optional": true },
    "@hanger-source/dsh-reactive-native-ui": { "optional": true }
  }
}
