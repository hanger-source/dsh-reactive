{
  "name": "@hanger-source/dsh-reactive-client",
  "version": "0.20.2",
  "description": "dsh-reactive 的独立类型化客户端与纯远程合同",
  "license": "UNLICENSED",
  "author": "hanger",
  "publishConfig": { "registry": "https://registry.npmjs.org", "tag": "next", "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/hanger-source/dsh-reactive.git", "directory": "packages/client" },
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "node": "./lib/index.js",
      "browser": "./lib/client.browser.js",
      "default": "./lib/client.browser.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types.d.ts",
      "import": "./lib/types.js"
    },
    "./errors": {
      "types": "./lib/errors.d.ts",
      "import": "./lib/errors.js"
    },
    "./transport": {
      "types": "./lib/transport.d.ts",
      "import": "./lib/transport.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "import": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/**/*.d.ts",
    "release.json"
  ],
  "scripts": {
    "build:contracts": "wireit",
    "build": "wireit",
    "build:browser": "wireit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:compile": "wireit",
    "prepack": "npm run build"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:browser"
      ]
    },
    "build:contracts": {
      "command": "node ../../scripts/archive-build-output.mjs build:contracts && tsc -p tsconfig.contracts.json",
      "dependencies": [
        "../core:build:compile"
      ],
      "files": [
        "src/types.ts",
        "src/errors.ts",
        "src/transport.ts",
        "src/inbox.ts",
        "tsconfig.contracts.json",
        "../../tsconfig.base.json",
        "../../scripts/archive-build-output.mjs",
        "package.json"
      ],
      "output": [
        "lib/types.*",
        "lib/errors.*",
        "lib/transport.*",
        "lib/inbox.*",
        "lib/contracts.tsbuildinfo"
      ],
      "clean": false
    },
    "build:compile": {
      "command": "node ../../scripts/archive-build-output.mjs build:compile && tsc -p tsconfig.json",
      "dependencies": [
        "build:contracts",
        "../remote:generate"
      ],
      "files": [
        "src/**",
        "!src/types.ts",
        "!src/errors.ts",
        "!src/transport.ts",
        "!src/inbox.ts",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../scripts/archive-build-output.mjs",
        "package.json"
      ],
      "output": [
        "lib/**",
        "!lib/types.*",
        "!lib/errors.*",
        "!lib/transport.*",
        "!lib/inbox.*",
        "!lib/contracts.tsbuildinfo",
        "!lib/typert.*",
        "!lib/client.browser.*"
      ],
      "clean": false
    },
    "build:browser": {
      "command": "node scripts/browser.mjs",
      "dependencies": [
        "build:compile"
      ],
      "files": [
        "scripts/browser.mjs"
      ],
      "output": [
        "lib/client.browser.js",
        "lib/client.browser.js.map"
      ],
      "clean": false
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@hanger-source/dsh-reactive": "0.20.2"
  },
  "devDependencies": {
    "@hanger-source/dsh-reactive": "file:../core"
  }
}
