{
  "name": "@hanger-source/dsh-reactive",
  "version": "0.38.0",
  "description": "基于 dsh 的双向响应式应用编程框架",
  "license": "UNLICENSED",
  "author": "hanger",
  "publishConfig": { "registry": "https://registry.npmjs.org", "tag": "next", "access": "public" },
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./program": {
      "types": "./lib/program/index.d.ts",
      "import": "./lib/program/index.js"
    },
    "./kernel": {
      "types": "./lib/kernel.d.ts",
      "import": "./lib/kernel.js"
    },
    "./actions": {
      "types": "./lib/actions/index.d.ts",
      "import": "./lib/actions/index.js"
    },
    "./applications": {
      "types": "./lib/applications/index.d.ts",
      "import": "./lib/applications/index.js"
    },
    "./collaboration": {
      "types": "./lib/collaboration/index.d.ts",
      "import": "./lib/collaboration/index.js"
    },
    "./conversations": {
      "types": "./lib/conversations/index.d.ts",
      "import": "./lib/conversations/index.js"
    },
    "./environments": {
      "types": "./lib/environments/index.d.ts",
      "import": "./lib/environments/index.js"
    },
    "./workspaces": {
      "types": "./lib/workspaces/index.d.ts",
      "import": "./lib/workspaces/index.js"
    },
    "./files": {
      "types": "./lib/files/index.d.ts",
      "import": "./lib/files/index.js"
    },
    "./journal": {
      "types": "./lib/journal/index.d.ts",
      "import": "./lib/journal/index.js"
    },
    "./attachments": {
      "types": "./lib/attachments/index.d.ts",
      "import": "./lib/attachments/index.js"
    },
    "./operations": {
      "types": "./lib/operations/index.d.ts",
      "import": "./lib/operations/index.js"
    },
    "./participation": {
      "types": "./lib/participation/index.d.ts",
      "import": "./lib/participation/index.js"
    },
    "./reactivity": {
      "types": "./lib/reactivity/index.d.ts",
      "import": "./lib/reactivity/index.js"
    },
    "./resources": {
      "types": "./lib/resources/index.d.ts",
      "import": "./lib/resources/index.js"
    },
    "./reactions": {
      "types": "./lib/reactions/index.d.ts",
      "import": "./lib/reactions/index.js"
    },
    "./surfaces": {
      "types": "./lib/surfaces/index.d.ts",
      "import": "./lib/surfaces/index.js"
    },
    "./tools": {
      "types": "./lib/tools/index.d.ts",
      "import": "./lib/tools/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/**/*.d.ts",
    "README.md",
    "CONTRIBUTING.md",
    "docs",
    "examples/merchant-operations",
    "examples/capabilities",
    "examples/fleet-inspection",
    "CHANGELOG.md", "release.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanger-source/dsh-reactive.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "wireit",
    "build:assets": "wireit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare:package": "wireit",
    "prepack": "npm run prepare:package",
    "build:compile": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:compile"
      ]
    },
    "prepare:package": {
      "dependencies": [
        "build",
        "build:assets"
      ]
    },
    "build:compile": {
      "command": "node ../../scripts/archive-build-output.mjs build:compile && tsc -p tsconfig.json",
      "dependencies": [],
      "files": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../scripts/archive-build-output.mjs",
        "package.json"
      ],
      "output": [
        "lib/**"
      ],
      "clean": false
    },
    "build:assets": {
      "command": "node scripts/package-assets.mjs",
      "files": [
        "scripts/package-assets.mjs",
        "../../README.md",
        "../../CONTRIBUTING.md",
        "../../docs/**",
        "../../examples/merchant-operations/**",
        "../../examples/capabilities/**",
        "../../examples/fleet-inspection/**"
      ],
      "output": [
        "README.md",
        "CONTRIBUTING.md",
        "docs/**",
        "examples/**"
      ],
      "clean": false
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-workspace-files": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@preact/signals-core": "1.14.4",
    "rxjs": "7.8.2",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.3"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-reconciler": "0.34.0",
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.34.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-reconciler": "0.34.0",
    "@types/react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-reconciler": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  }
}
