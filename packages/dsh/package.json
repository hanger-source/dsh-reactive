    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.1-rc.3"
  },
  "devDependencies": {
    "@hanger-source/dsh-reactive": "file:../core",
