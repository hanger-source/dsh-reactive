{
  "name": "@hanger-source/dsh-reactive-dsh",
  "version": "0.20.2",
  "description": "dsh-reactive 的原生 dsh 运行宿主与可选能力域",
  "license": "UNLICENSED",
  "author": "hanger",
  "publishConfig": { "registry": "https://registry.npmjs.org", "tag": "next", "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/hanger-source/dsh-reactive.git", "directory": "packages/dsh" },
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./jobs": {
      "types": "./lib/jobs.d.ts",
      "import": "./lib/jobs.js"
    },
    "./mcp": {
      "types": "./lib/mcp.d.ts",
      "import": "./lib/mcp.js"
    },
    "./approval": {
      "types": "./lib/approval.d.ts",
      "import": "./lib/approval.js"
    },
    "./time": {
      "types": "./lib/time.d.ts",
      "import": "./lib/time.js"
    },
    "./schedule": {
      "types": "./lib/schedule.d.ts",
      "import": "./lib/schedule.js"
    },
    "./team": {
      "types": "./lib/team.d.ts",
      "import": "./lib/team.js"
    },
    "./tools": {
      "types": "./lib/tools.d.ts",
      "import": "./lib/tools.js"
    },
    "./skills": {
      "types": "./lib/skills.d.ts",
      "import": "./lib/skills.js"
    },
    "./files": {
      "types": "./lib/files.d.ts",
      "import": "./lib/files.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.map",
    "lib/**/*.d.ts",
    "release.json"
  ],
  "scripts": {
    "build": "wireit",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:compile": "wireit",
    "prepack": "npm run build"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:compile"
      ]
    },
    "build:compile": {
      "command": "node ../../scripts/archive-build-output.mjs build:compile && tsc -p tsconfig.json",
      "dependencies": [
        "../core:build:compile"
      ],
      "files": [
        "src/**",
        "tsconfig.json",
        "../../tsconfig.base.json",
        "../../scripts/archive-build-output.mjs",
        "package.json"
      ],
      "output": [
        "lib/**"
      ],
      "clean": false
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
