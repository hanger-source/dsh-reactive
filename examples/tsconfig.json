{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "merchant-operations/**/*.ts",
    "merchant-operations/**/*.tsx",
    "capabilities/**/*.ts",
    "capabilities/**/*.tsx",
    "fleet-inspection/**/*.ts",
    "fleet-inspection/**/*.tsx"
  ]
}
