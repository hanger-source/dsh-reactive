    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.34.1",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "typescript": "5.9.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-rc.3",
    "@hanger-source/dsh-reactive": "file:packages/core",
    "@changesets/cli": "3.0.3",
    "semver": "7.8.1",
    "dependency-cruiser": "18.7.0",
    "publint": "0.3.25",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.3",
    "zustand": "5.0.16",
    "immer": "11.2.9"
  }
}
