    "@deepseek-ai/dsh-tool-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "quickjs-emscripten-core": "0.32.0",
    "react-reconciler": "0.34.0",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-jobs-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-resources": "0.2.1-rc.3",
    "@deepseek-ai/dsh-time-context": "0.2.1-rc.3",
