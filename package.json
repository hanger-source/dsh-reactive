{
  "name": "dsh-reactive-workspace",
  "private": true,
  "author": "hanger",
  "description": "基于 dsh 的双向响应式应用编程框架",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanger-source/dsh-reactive.git"
  },
  "scripts": {
    "typecheck:core": "tsc --noEmit",
    "typecheck": "wireit",
    "typecheck:examples": "tsc -p examples/tsconfig.json && tsc -p packages/native-ui/examples/tsconfig.json",
    "build:core": "wireit",
    "build": "wireit",
    "prepare:packages": "wireit",
    "build:test": "wireit",
    "test:core": "npm run build:test && node --test --test-timeout=15000 .tmp/test/test/*.test.js",
    "test:remote": "npm run build && npm run test --workspace @hanger-source/dsh-reactive-remote",
    "test:release": "node --test --test-timeout=30000 test/release-versioning.test.mjs",
    "test": "npm run test:core && npm run test:remote && npm run test --workspace @hanger-source/dsh-reactive-native-ui && npm run test:release",
    "browser:remote": "npm run build && npm run browser:serve --workspace @hanger-source/dsh-reactive-remote --",
    "build:dsh": "wireit",
    "build:native-ui": "wireit",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "pack:workspaces": "npm run prepare:packages && npm pack --workspaces --ignore-scripts --pack-destination .tmp",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs packages/*/src",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "wireit": {
    "typecheck": {
      "command": "npm run typecheck:core",
      "dependencies": ["build"],
      "files": ["test/**", "tsconfig.json", "tsconfig.base.json"]
    },
    "generate:remote": {
      "command": "node packages/remote/scripts/generate.mjs",
      "dependencies": ["./packages/dsh:build:compile", "./packages/client:build:contracts"],
      "files": ["packages/remote/src/**", "packages/remote/scripts/generate.mjs", "packages/remote/tsconfig.json", "tsconfig.base.json", "package.json", "packages/*/package.json"],
      "output": ["packages/remote/lib/typert.host.*", "packages/client/lib/typert.remote-client.*"],
      "clean": false
    },
    "build": {
      "dependencies": [
        "./packages/core:build",
        "./packages/dsh:build",
        "./packages/client:build",
        "./packages/remote:build",
        "./packages/native-ui:build",
        "./packages/skills:build"
      ]
    },
    "prepare:packages": {
      "dependencies": ["build", "./packages/core:prepare:package"]
    },
    "build:core": {
      "dependencies": [
        "./packages/core:build"
      ]
    },
    "build:dsh": {
      "dependencies": [
        "./packages/dsh:build"
      ]
    },
    "build:native-ui": {
      "dependencies": [
        "./packages/native-ui:build"
      ]
    },
    "build:test": {
      "command": "node scripts/prepare-test.mjs reset && tsc -p tsconfig.test.json && node scripts/prepare-test.mjs link",
      "dependencies": [
        "./packages/dsh:build"
      ]
    }
  },
  "devDependencies": {
    "rxjs": "7.8.2",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
