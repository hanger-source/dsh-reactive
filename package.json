{
  "name": "dsh-reactive-workspace",
  "private": true,
  "author": "hanger",
  "description": "基于 dsh 的双向响应式应用编程框架",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanger-source/dsh-reactive.git"
  },
  "scripts": {
    "typecheck:core": "tsc --noEmit",
    "typecheck": "npm run typecheck:core && npm run build && npm run typecheck:examples",
    "typecheck:examples": "tsc -p examples/tsconfig.json && tsc -p packages/native-ui/examples/tsconfig.json",
    "build:core": "npm run build --workspace @hanger-source/dsh-reactive",
    "build": "npm run build:dsh && npm run build:contracts --workspace @hanger-source/dsh-reactive-client && npm run generate --workspace @hanger-source/dsh-reactive-remote && tsc -b tsconfig.build.json && npm run build:assets --workspace @hanger-source/dsh-reactive && npm run build:browser --workspace @hanger-source/dsh-reactive-client && npm run build --workspace @hanger-source/dsh-reactive-skills",
    "build:test": "node scripts/prepare-test.mjs reset && npm run build:dsh && tsc -p tsconfig.test.json && node scripts/prepare-test.mjs link",
    "test:core": "npm run build:test && node --test --test-timeout=15000 .tmp/test/test/*.test.js",
    "test:remote": "npm run build && npm run test --workspace @hanger-source/dsh-reactive-remote",
    "test": "npm run test:core && npm run test:remote",
    "browser:remote": "npm run build && npm run browser:serve --workspace @hanger-source/dsh-reactive-remote",
    "build:dsh": "npm run build --workspace @hanger-source/dsh-reactive-dsh",
    "build:native-ui": "npm run build --workspace @hanger-source/dsh-reactive-native-ui",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "pack:workspaces": "npm pack --workspaces --ignore-scripts --pack-destination .tmp",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs packages/*/src",
    "check:packages": "node scripts/check-packages.mjs"
  },
  "devDependencies": {
    "rxjs": "7.8.2",
    "zod": "4.4.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-file-upload": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-goal": "0.2.1-rc.3",
    "@deepseek-ai/dsh-goal-round-driver": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
